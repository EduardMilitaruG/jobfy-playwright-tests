{
  "name": "jobfy-playwright-tests",
  "version": "1.0.0",
  "description": "End-to-end test suite for JobFy application using Playwright",
  "author": "Eduard Militaru",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:api": "playwright test tests/api.spec.js",
    "report": "playwright show-report",
    "debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation",
    "qa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardMilitaruG/jobfy-playwright-tests"
  }
}
