{
  "name": "jobfy-playwright-tests",
  "version": "1.0.0",
  "description": "End-to-end test suite for JobFy application using Playwright",
  "author": "Eduard Militaru",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:e2e && npm run test:unit && npm run test:integration",
    "test:all": "npm run test:e2e && npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:api": "playwright test tests/api.spec.js",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:unit:watch": "jest --watch --testMatch='**/tests/unit/**/*.test.js'",
    "test:unit:coverage": "jest --coverage --testMatch='**/tests/unit/**/*.test.js'",
    "test:integration": "jest --testMatch='**/tests/integration/**/*.test.js'",
    "test:integration:watch": "jest --watch --testMatch='**/tests/integration/**/*.test.js'",
    "test:integration:coverage": "jest --coverage --testMatch='**/tests/integration/**/*.test.js'",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "coverage": "npm run coverage:jest && npm run coverage:e2e",
    "coverage:jest": "jest --coverage",
    "coverage:e2e": "c8 playwright test",
    "coverage:report": "npm run report:jest && npm run report:e2e",
    "report": "npm run report:e2e",
    "report:e2e": "playwright show-report",
    "report:jest": "open coverage/jest/test-report.html || xdg-open coverage/jest/test-report.html",
    "report:coverage": "open coverage/jest/index.html || xdg-open coverage/jest/index.html",
    "debug": "playwright test --debug",
    "debug:jest": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "c8": "^10.1.3",
    "jest": "^30.2.0",
    "jest-html-reporter": "^4.3.0",
    "playwright-test-coverage": "^1.2.12",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation",
    "qa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardMilitaruG/jobfy-playwright-tests"
  }
}
