{
  "name": "jobfy-playwright-tests",
  "version": "3.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E and API tests for JobFy v2",
  "author": "Eduard Militaru",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EduardMilitaruG/jobfy-playwright-tests"
  }
}
